-- VISUALS TAB (ESP)
do
    local espColorMap={Red=Color3.fromRGB(255,0,0),Purple=Color3.fromRGB(138,43,226),Green=Color3.fromRGB(0,255,0),Blue=Color3.fromRGB(0,170,255),White=Color3.fromRGB(255,255,255),Yellow=Color3.fromRGB(255,255,0),Cyan=Color3.fromRGB(0,255,255),Orange=Color3.fromRGB(255,165,0),Pink=Color3.fromRGB(255,105,180)}
    local chamsFillColor=Color3.fromRGB(138,43,226); local chamsOutlineColor=Color3.fromRGB(255,0,255)
    local ESPSettings={Enabled=false,BoxESP=false,BoxFill=false,BoxCorners=false,NameESP=false,HealthESP=false,TracerESP=false,DistanceESP=false,BoxColor=Color3.fromRGB(255,0,0),TracerColor=Color3.fromRGB(0,255,0),TextColor=Color3.fromRGB(255,255,255),MaxDistance=800}
    local ESPObjects={}; local ChamsHighlights={}
    local function CreateESPForPlayer(plr)
        if plr==LocalPlayer or ESPObjects[plr] then return end
        local corners={}; for i=1,8 do local ln=Drawing.new("Line"); ln.Thickness=2; ln.Color=ESPSettings.BoxColor; ln.Visible=false; corners[i]=ln end
        local b3d={}; for i=1,12 do local ln=Drawing.new("Line"); ln.Thickness=1; ln.Color=ESPSettings.BoxColor; ln.Visible=false; b3d[i]=ln end
        ESPObjects[plr]={Box=Drawing.new("Square"),Corners=corners,Name=Drawing.new("Text"),Health=Drawing.new("Text"),Distance=Drawing.new("Text"),Tracer=Drawing.new("Line"),TracerOutline=Drawing.new("Line"),Box3D=b3d}
        local e=ESPObjects[plr]
        e.Box.Thickness=1; e.Box.Filled=false; e.Box.Color=ESPSettings.BoxColor; e.Box.Visible=false
        e.Name.Size=14; e.Name.Center=true; e.Name.Outline=true; e.Name.Color=ESPSettings.TextColor; e.Name.Visible=false
        e.Health.Size=12; e.Health.Center=true; e.Health.Outline=true; e.Health.Color=Color3.fromRGB(0,255,0); e.Health.Visible=false
        e.Distance.Size=12; e.Distance.Center=true; e.Distance.Outline=true; e.Distance.Color=Color3.fromRGB(255,255,0); e.Distance.Visible=false
        e.Tracer.Thickness=1; e.Tracer.Color=ESPSettings.TracerColor; e.Tracer.Visible=false
        e.TracerOutline.Thickness=3; e.TracerOutline.Color=Color3.new(0,0,0); e.TracerOutline.Visible=false
    end
    local function RemoveESPForPlayer(plr)
        if not ESPObjects[plr] then return end
        local e=ESPObjects[plr]
        for _,ln in ipairs(e.Box3D or {}) do pcall(function() ln:Remove() end) end
        for _,ln in ipairs(e.Corners or {}) do pcall(function() ln:Remove() end) end
        for k,d in pairs(e) do
            if k~="Box3D" and k~="Corners" then pcall(function() d:Remove() end) end
        end
        ESPObjects[plr]=nil
    end
    local function UpdateESP()
        if not ESPSettings.Enabled then
            for _,e in pairs(ESPObjects) do
                pcall(function()
                    e.Box.Visible=false; e.Name.Visible=false; e.Health.Visible=false
                    e.Distance.Visible=false; e.Tracer.Visible=false; e.TracerOutline.Visible=false
                    for _,ln in ipairs(e.Corners or {}) do ln.Visible=false end
                    for _,ln in ipairs(e.Box3D or {}) do ln.Visible=false end
                end)
            end
            return
        end
        local cam=workspace.CurrentCamera; local vp=cam.ViewportSize
        for plr,e in pairs(ESPObjects) do
            pcall(function()
                local char=plr.Character
                local hx=char and char:FindFirstChildOfClass("Humanoid")
                local hrp=char and char:FindFirstChild("HumanoidRootPart")
                local head=char and char:FindFirstChild("Head")
                local function hide()
                    e.Box.Visible=false; e.Name.Visible=false; e.Health.Visible=false
                    e.Distance.Visible=false; e.Tracer.Visible=false; e.TracerOutline.Visible=false
                    for _,ln in ipairs(e.Corners or {}) do ln.Visible=false end
                    for _,ln in ipairs(e.Box3D or {}) do ln.Visible=false end
                end
                if not (char and hx and hrp and head and hx.Health>0) then hide(); return end
                local rp,on=cam:WorldToViewportPoint(hrp.Position)
                local hp2=cam:WorldToViewportPoint(head.Position+Vector3.new(0,0.5,0))
                local lp2=cam:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0))
                local dist=(hrp.Position-cam.CFrame.Position).Magnitude
                if not (on and rp.Z>0 and dist<=ESPSettings.MaxDistance) then hide(); return end
                local bH=math.abs(hp2.Y-lp2.Y); local bW=math.max(bH/2,10)
                if ESPSettings.BoxESP then
                    e.Box.Filled=ESPSettings.BoxFill
                    e.Box.Size=Vector2.new(bW,bH)
                    e.Box.Position=Vector2.new(rp.X-bW/2, hp2.Y)
                    e.Box.Color=ESPSettings.BoxColor
                    e.Box.Visible=true
                else e.Box.Visible=false end
                if ESPSettings.BoxCorners and e.Corners then
                    local bx=rp.X-bW/2; local by=hp2.Y
                    local cw=math.max(bW*.25,5); local ch=math.max(bH*.25,5)
                    local col=ESPSettings.BoxColor; local co=e.Corners
                    co[1].From=Vector2.new(bx,by); co[1].To=Vector2.new(bx+cw,by)
                    co[2].From=Vector2.new(bx,by); co[2].To=Vector2.new(bx,by+ch)
                    co[3].From=Vector2.new(bx+bW,by); co[3].To=Vector2.new(bx+bW-cw,by)
                    co[4].From=Vector2.new(bx+bW,by); co[4].To=Vector2.new(bx+bW,by+ch)
                    co[5].From=Vector2.new(bx,by+bH); co[5].To=Vector2.new(bx+cw,by+bH)
                    co[6].From=Vector2.new(bx,by+bH); co[6].To=Vector2.new(bx,by+bH-ch)
                    co[7].From=Vector2.new(bx+bW,by+bH); co[7].To=Vector2.new(bx+bW-cw,by+bH)
                    co[8].From=Vector2.new(bx+bW,by+bH); co[8].To=Vector2.new(bx+bW,by+bH-ch)
                    for _,ln in ipairs(co) do ln.Color=col; ln.Visible=true end
                elseif e.Corners then
                    for _,ln in ipairs(e.Corners) do ln.Visible=false end
                end
                if ESPSettings.NameESP then
                    e.Name.Text=plr.Name; e.Name.Position=Vector2.new(rp.X,hp2.Y-18)
                    e.Name.Color=ESPSettings.TextColor; e.Name.Visible=true
                else e.Name.Visible=false end
                if ESPSettings.HealthESP then
                    local hp=math.clamp(hx.Health/hx.MaxHealth,0,1)
                    e.Health.Text=math.floor(hp*100).."%"
                    e.Health.Position=Vector2.new(rp.X,lp2.Y+5)
                    e.Health.Color=Color3.fromRGB(math.floor((1-hp)*255),math.floor(hp*255),0)
                    e.Health.Visible=true
                else e.Health.Visible=false end
                if ESPSettings.DistanceESP then
                    e.Distance.Text="["..math.floor(dist).."m]"
                    e.Distance.Position=Vector2.new(rp.X,lp2.Y+18)
                    e.Distance.Visible=true
                else e.Distance.Visible=false end
                if ESPSettings.TracerESP then
                    local fr=Vector2.new(vp.X/2,vp.Y); local to=Vector2.new(rp.X,lp2.Y)
                    e.TracerOutline.From=fr; e.TracerOutline.To=to; e.TracerOutline.Visible=true
                    e.Tracer.From=fr; e.Tracer.To=to; e.Tracer.Color=ESPSettings.TracerColor; e.Tracer.Visible=true
                else e.Tracer.Visible=false; e.TracerOutline.Visible=false end
            end)
        end
    end
    for _,plr in pairs(Players:GetPlayers()) do CreateESPForPlayer(plr) end
